# FCGS Gate Bridge - example local configuration only.
# Never commit the real token or device password.
FCGS_GATE_BRIDGE_URL=https://portal.firstchoicegroup.co.zw
FCGS_GATE_BRIDGE_TOKEN=fcgs_gb_REPLACE_WITH_TOKEN_SHOWN_ONCE_IN_PORTAL
FCGS_GATE_BRIDGE_POLL_MS=1500
FCGS_GATE_BRIDGE_HEARTBEAT_MS=15000
FCGS_GATE_BRIDGE_PROBE_MS=30000

# Copy each deviceKey from Access Control > Devices after registering the terminal.
# The terminal host/password stay on the school Gate Bridge and are NOT stored in the FCGS Portal.
FCGS_GATE_BRIDGE_DEVICES=[{"deviceKey":"00000000-0000-0000-0000-000000000000","host":"192.168.1.50","port":9090,"username":"admin","password":"REPLACE_ME"}]
