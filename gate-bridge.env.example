# FCGS Gate Bridge - local machine configuration.
# Never commit the real bridge token or terminal password.
#
# Production URL is the built-in default. Override this only for local/dev testing,
# for example: http://localhost:5000 when FCGS is running on the same computer.
FCGS_GATE_BRIDGE_URL=https://portal.firstchoicegroup.co.zw
FCGS_GATE_BRIDGE_TOKEN=fcgs_gb_REPLACE_WITH_TOKEN_SHOWN_ONCE_IN_PORTAL

# Shared face-terminal credentials remain LOCAL to this Gate Bridge.
# Terminal IP addresses, ports, Gate and lane assignments now come from FCGS automatically.
FCGS_GATE_DEVICE_USERNAME=admin
FCGS_GATE_DEVICE_PASSWORD=REPLACE_ME
# Set true only when the value above is already the terminal's lowercase 32-character MD5 digest.
FCGS_GATE_DEVICE_PASSWORD_IS_MD5=false

FCGS_GATE_BRIDGE_POLL_MS=1500
FCGS_GATE_BRIDGE_CONFIG_MS=5000
FCGS_GATE_BRIDGE_HEARTBEAT_MS=15000
FCGS_GATE_BRIDGE_PROBE_MS=30000

# Optional local diagnostic log folder. If omitted, ./gate-bridge-logs is used.
# FCGS_GATE_BRIDGE_LOG_DIR=C:\ProgramData\FCGS\Gate Bridge\logs

# BACKWARD-COMPATIBILITY ONLY:
# Existing installations may temporarily keep per-device credentials here. When a matching
# deviceKey exists, ONLY its credentials are used as an override; host/port are controlled
# by FCGS once the bridge can synchronize configuration.
FCGS_GATE_BRIDGE_DEVICES=[]
